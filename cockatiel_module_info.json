{
  "autostart": true,
  "binary": {
    "linux": {
      "aarch64": "target/release/twitch-adapter-rs",
      "arm": "target/release/twitch-adapter-rs",
      "x86_64": "target/release/twitch-adapter-rs"
    },
    "macos": {
      "aarch64": "target/release/twitch-adapter-rs",
      "arm": "target/release/twitch-adapter-rs",
      "x86_64": "target/release/twitch-adapter-rs"
    },
    "windows": {
      "aarch64": "target/release/twitch-adapter-rs.exe",
      "arm": "target/release/twitch-adapter-rs.exe",
      "x86_64": "target/release/twitch-adapter-rs.exe"
    }
  },
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ],
  "capabilities": "input",
  "command_flags": [
    "--release"
  ],
  "credentials": [
    {
      "env": "",
      "key": "channel",
      "label": "Channel",
      "list": false,
      "sensitive": false
    },
    {
      "env": "TWITCH_CLIENT_ID",
      "key": "client_id",
      "label": "Client ID (dev.twitch.tv)",
      "list": false,
      "sensitive": true
    },
    {
      "env": "",
      "key": "username",
      "label": "Bot Username",
      "list": false,
      "sensitive": false
    },
    {
      "env": "TWITCH_OAUTH_TOKEN",
      "key": "oauth_token",
      "label": "OAuth Token (auto-acquired)",
      "list": false,
      "optional": true,
      "sensitive": true
    }
  ],
  "description": "a module for getting and sending messages to twitch",
  "launch_command": "cargo run",
  "name": "twitch-adapter",
  "root_file": "./src/main.rs",
  "version": "0.1.0",
  "price": 0,
  "min_rank": 0
}